t}.outline:hover{background:#224451}.hero-art{height:370px;position:relative;display:grid;place-items:center}.orbit{width:320px;height:320px;border:1px solid #37626b;border-radius:50%;display:grid;place-items:center;position:relative}.orbit:before{content:"";position:absolute;inset:40px;border:1px dashed #416d75;border-radius:50%}.core{width:154px;height:154px;border-radius:24px;background:#1c4856;display:grid;place-items:center;box-shadow:0 20px 70px #09212d;font-weight:900;font-size:45px;letter-spacing:-4px;color:#5cdbd1;transform:rotate(-7deg)}.dot{position:absolute;width:15px;height:15px;border-radius:50%;background:#24B8AE;box-shadow:0 0 0 9px rgba(36,184,174,.1)}.d1{top:34px;right:55px}.d2{bottom:25px;left:55px}.d3{top:145px;left:-7px}.stats{background:#f0f6f6;border-bottom:1px solid #e3ecec}.stats-inner{display:grid;grid-template-columns:repeat(3,1fr);gap:25px;padding:24px 0}.stat{font-weight:700;font-size:14px;display:flex;align-items:center;gap:12px}.check{color:#087f79;font-size:20px}section.section{padding:100px 0}.section-head{max-width:720px;margin-bottom:42px}.section-head h2{font-size:clamp(31px,4vw,46px);letter-spacing:-1.5px;line-height:1.17;margin:0 0 18px}.section-head p{color:#60727a;line-height:1.75;font-size:17px;margin:0}.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.service{border:1px solid #e0eaea;border-radius:15px;padding:31px;background:#fff;min-height:300px;display:flex;flex-direction:column}.service .num{font-size:14px;font-weight:850;color:#0c9e96;margin-bottom:43px}.service h3{font-size:22px;letter-spacing:-.6px;line-height:1.25;margin:0 0 14px}.service p{font-size:15px;line-height:1.7;color:#5d7179;margin:0 0 25px}.service small{margin-top:auto;color:#147d79;font-weight:750;line-height:1.6}.soft{background:#f2f7f7}.solution{background:white;border:1px solid #e2ebeb;border-radius:15px;overflow:hidden}.solution-top{height:135px;background:linear-gradient(135deg,#173b4b,#236579);position:relative;display:flex;align-items:center;justify-content:center}.solution-top:after{content:"";width:90px;height:90px;border:2px solid #50c8bf;border-radius:20px;transform:rotate(25deg);box-shadow:0 0 0 18px rgba(80,200,191,.08)}.solution-body{padding:27px}.pill{display:inline-block;color:#0a7773;background:#e5f7f5;border-radius:30px;padding:6px 10px;font-size:11px;font-weight:800;margin-bottom:14px}.solution h3{font-size:21px;line-height:1.35;margin:0 0 12px}.solution p{font-size:15px;color:#60727a;line-height:1.75;margin:0}.about{display:grid;grid-template-columns:.85fr 1.15fr;gap:75px;align-items:start}.about-copy h2{font-size:43px;letter-spacing:-1.4px;margin:0 0 20px}.about-copy p{line-height:1.8;color:#60727a}.founders{display:grid;gap:13px}.person{border:1px solid #e0eaea;padding:21px;border-radius:13px;display:flex;gap:19px;align-items:center}.avatar{flex:none;width:56px;height:56px;border-radius:13px;background:#dff4f1;color:#0b7975;display:grid;place-items:center;font-size:24px;font-weight:850}.person h3{font-size:17px;margin:0 0 4px}.person strong{font-size:13px;color:#117d78}.person p{font-size:13px;color:#60727a;line-height:1.5;margin:7px 0 0}.contact{background:#142E3C;color:#fff;padding:85px 0}.contact-inner{display:flex;justify-content:space-between;align-items:center;gap:30px}.contact h2{font-size:clamp(30px,4vw,46px);letter-spacing:-1px;max-width:650px;margin:0 0 16px}.contact p{color:#bed0d5;line-height:1.7;max-width:650px;margin:0}.contact .btn{white-space:nowrap}.footer{background:#0f2632;color:#b6c9ce;padding:27px 0;font-size:13px}.foot{display:flex;justify-content:space-between;gap:15px}.foot b{color:#fff}a:focus-visible{outline:3px solid #24B8AE;outline-offset:4px}@media(max-width:850px){.links{gap:14px}.links a:nth-child(3),.links a:nth-child(4){display:none}.hero-inner{grid-template-columns:1fr;padding:85px 0}.hero-art{display:none}.grid3{grid-template-columns:1fr 1fr}.about{grid-template-columns:1fr;gap:25px}.contact-inner{align-items:start;flex-direction:column}}@media(max-width:600px){.wrap{width:min(100% - 32px,1140px)}.nav{min-height:70px}.links a:not(.navcta){display:none}.navcta{padding:11px 13px;font-size:12px}.brand{font-size:22px}.hero-inner{padding:76px 0 88px}.hero h1{letter-spacing:-1.6px}.hero p{font-size:16px}.stats-inner{grid-template-columns:1fr;gap:13px}.grid3{grid-template-columns:1fr}section.section{padding:70px 0}.service{min-height:unset}.service .num{margin-bottom:25px}.about-copy h2{font-size:35px}.contact{padding:68px 0}.foot{flex-direction:column}}
